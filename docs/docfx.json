{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/Celeritas",
          "files": [ "Celeritas.csproj" ]
        }
      ],
      "dest": "api",
      "namespaceLayout": "nested",
      "memberLayout": "samePage",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**.yml", "api/index.md" ]
      },
      {
        "files": [ "index.md", "toc.yml", "COOKBOOK.md", "adr/**.md" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "Celeritas",
      "_appTitle": "Celeritas — symbolic-music engine for .NET",
      "_enableSearch": true,
      "_disableContribution": true,
      "pdf": false
    },
    "sitemap": {
      "baseUrl": "https://sheinv78.github.io/Celeritas"
    }
  }
}
