<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <OptimizationPreference>Speed</OptimizationPreference>

        <!-- Enable native exports for Python bindings -->
        <EnableDynamicLoading>true</EnableDynamicLoading>

        <!-- NuGet Package metadata (version is set centrally in Directory.Build.props) -->
        <PackageId>Celeritas</PackageId>
        <Authors>Vladimir V. Shein</Authors>
        <Company>Vladimir V. Shein</Company>
        <Product>Celeritas Music Engine</Product>
        <Description>High-Performance Music Engine for .NET with SIMD acceleration (AVX-512, AVX2, SSE2, ARM NEON). Provides harmonic analysis, chord recognition, key detection, voice leading, melody harmonization, rhythm analysis, MIDI I/O, and pitch class set analysis.</Description>
        <Copyright>Copyright (c) 2025 Vladimir V. Shein</Copyright>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <PackageProjectUrl>https://github.com/sheinv78/Celeritas</PackageProjectUrl>
        <RepositoryUrl>https://github.com/sheinv78/Celeritas</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>music;midi;simd;audio;daw;chord;harmony;analysis;avx512;avx2;neon;voice-leading;key-detection;rhythm;melody;counterpoint</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>v0.9.0: Ornaments, Figured Bass, ARM NEON SIMD, WebAssembly SIMD, Python bindings</PackageReleaseNotes>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!-- ANTLR4 code generation -->
        <Antlr4UseCSharpGenerator>true</Antlr4UseCSharpGenerator>

        <!-- SourceLink: embed repository info so consumers can step into sources -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <!-- XML documentation: ship docs with the package and gate on completeness.
             Every public member carries an XML doc; CS1591 is left as a warning so
             TreatWarningsAsErrors fails the build (and CI) on any new undocumented
             public API. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Celeritas.Tests" />
      <!-- The NativeAOT export layer for the Python bindings is part of this product and
           drives the internal SIMD dispatch directly. -->
      <InternalsVisibleTo Include="Celeritas.Native" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
      <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
      <!-- Pinned at 12.8.0: bumping this build-time ANTLR code generator forces grammar
           regeneration, which requires a Java toolchain in every build environment. -->
      <PackageReference Include="Antlr4BuildTasks" Version="12.8.0" PrivateAssets="all" />
      <!-- Antlr4BuildTasks transitively pulls Microsoft.Build.Utilities.Core, whose older
           builds carry a high-severity advisory (CVE-2025-55247 / GHSA-w3q9-fxm7-j8fq, NU1903).
           Pin a patched version directly; PrivateAssets=all + ExcludeAssets=runtime keep it
           build-time only (it never ships in the package). -->
      <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.7.1" PrivateAssets="all" ExcludeAssets="runtime" />
      <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="all" />

      <!-- Public API surface tracking: any public API change not recorded in
           PublicAPI.{Shipped,Unshipped}.txt is flagged (RS0016/RS0017). This is the
           guardrail for curating and freezing the API on the road to 1.0. -->
      <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="PublicAPI.Shipped.txt" />
      <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <ItemGroup>
      <Antlr4 Include="Grammar\MusicNotation.g4">
        <Package>Celeritas.Core.Grammar</Package>
        <Listener>false</Listener>
        <Visitor>true</Visitor>
      </Antlr4>

      <Antlr4 Include="Grammar\ChordSymbol.g4">
        <Package>Celeritas.Core.Grammar</Package>
        <Listener>false</Listener>
        <Visitor>true</Visitor>
      </Antlr4>
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\README.md" Pack="true" PackagePath="\" />
      <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
